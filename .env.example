# Copy to .env.local for local use. On Vercel, set these in Project Settings > Environment Variables.

# Resend API key (server only). Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where leads are sent. Until the domain is verified, this must be the email that owns the Resend account.
INQUIRY_TO_EMAIL=

# Sender. Use onboarding@resend.dev until the domain is verified.
INQUIRY_FROM_EMAIL="XELATION <onboarding@resend.dev>"

# Keep false until the domain is verified.
SEND_CONFIRMATION_EMAIL=false
